  "normalization_plan": [
    {
      "reason": "_to has no independent security semantics; it is the recipient argument bound directly into the transfer function",
      "normal_node": "param_transfer_to",
      "merge_into": "StandardToken.transfer"
    },
    {
      "reason": "_value only parameterizes the transfer balance updates and should be folded into the transfer function node",
      "normal_node": "param_transfer_value",
      "merge_into": "StandardToken.transfer"
    },
    {
      "reason": "_to is a plain recipient argument of transferFrom and carries no standalone vulnerability semantics",
      "normal_node": "param_transferFrom_to",
      "merge_into": "StandardToken.transferFrom"
    },
    {
      "reason": "_value parameterizes the transferFrom balance and allowance updates",
      "normal_node": "param_transferFrom_value",
      "merge_into": "StandardToken.transferFrom"
    },
    {
      "reason": "_from is the debited account argument used only inside transferFrom",
      "normal_node": "param_transferFrom_from",
      "merge_into": "StandardToken.transferFrom"
    },
    {
      "reason": "_owner is a read-only lookup key consumed exclusively by balanceOf",
      "normal_node": "param_balanceOf_owner",
      "merge_into": "StandardToken.balanceOf"
    },
    {
      "reason": "_spender only keys the allowance write performed by approve",
      "normal_node": "param_approve_spender",
      "merge_into": "StandardToken.approve"
    },
    {
      "reason": "_value is the allowance amount written only by approve",
      "normal_node": "param_approve_value",
      "merge_into": "StandardToken.approve"
    },
    {
      "reason": "_owner is a read-only lookup key used solely by allowance",
      "normal_node": "param_allowance_owner",
      "merge_into": "StandardToken.allowance"
    },
    {
      "reason": "_spender is a read-only lookup key used solely by allowance",
      "normal_node": "param_allowance_spender",
      "merge_into": "StandardToken.allowance"
    },
    {
      "reason": "_BAT is only assigned into the BAT state variable during construction",
      "normal_node": "param_constructor_BAT",
      "merge_into": "BATSafe.constructor"
    },
    {
      "reason": "success is a pure return flag of transfer with no independent flow",
      "normal_node": "local_transfer_success",
      "merge_into": "StandardToken.transfer"
    },
    {
      "reason": "success is a pure return flag of transferFrom with no independent flow",
      "normal_node": "local_transferFrom_success",
      "merge_into": "StandardToken.transferFrom"
    },
    {
      "reason": "balance is the returned value of balanceOf and adds no extra semantics",
      "normal_node": "local_balanceOf_balance",
      "merge_into": "StandardToken.balanceOf"
    },
    {
      "reason": "success is the constant-true return flag of approve",
      "normal_node": "local_approve_success",
      "merge_into": "StandardToken.approve"
    },
    {
      "reason": "remaining is the returned value of allowance and has no standalone effect",
      "normal_node": "local_allowance_remaining",
      "merge_into": "StandardToken.allowance"
    },
    {
      "reason": "entitled is read from allocations and immediately consumed by the unchecked entitled * exponent multiplication",
      "normal_node": "local_unlock_entitled",
      "merge_into": "unlock.entitled_mul"
    }
  ]
