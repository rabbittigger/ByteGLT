      "normal_node": "param.getMetalBlockRewardMultiplier.blockNumber"
    },
    {
      "reason": "Bounds-checked against ships length",
      "merge_into": "MetaShipItems.getShipRarityLevel",
      "normal_node": "param.getShipRarityLevel.tokenId"
    },
    {
      "reason": "Computed reward minted during harvest",
      "merge_into": "MetaShipItems.harvestMetal",
      "normal_node": "local.harvestMetal.pendingMetal"
    },
    {
      "reason": "Accumulator returned from getPendingMetal",
      "merge_into": "MetaShipItems.getPendingMetal",
      "normal_node": "local.getPendingMetal.metalCollected"
    },
    {
      "reason": "Returned array of minted ids",
      "merge_into": "MetaShipItems.purchaseRandomShip",
      "normal_node": "local.purchaseRandomShip.ship_ids"
    },
    {
      "reason": "Loop counter for ship generation",
      "merge_into": "MetaShipItems.purchaseRandomShip",
      "normal_node": "local.purchaseRandomShip.x"
    },
    {
      "reason": "Accumulated reward minted in batch harvest",
      "merge_into": "MetaShipItems.harvestAllMetal",
      "normal_node": "local.harvestAllMetal.totalPendingMetal"
    }
  ]
}