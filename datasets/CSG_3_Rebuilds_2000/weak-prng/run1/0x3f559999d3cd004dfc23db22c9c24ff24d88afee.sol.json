  "normalization_plan": [
    {
      "reason": "_newOwner only feeds the changeOwnership authorization flow.",
      "merge_into": "fn_changeOwnership",
      "normal_node": "p_newOwner"
    },
    {
      "reason": "_to is the recipient consumed by transfer/mint balance updates.",
      "merge_into": "fn_transfer",
      "normal_node": "p_to"
    },
    {
      "reason": "_value is the amount minted and credited to balances.",
      "merge_into": "fn_mint",
      "normal_node": "p_value"
    },
    {
      "reason": "_recipient is the beneficiary key of the subscription mapping.",
      "merge_into": "fn_subscribe",
      "normal_node": "p_recipient"
    },
    {
      "reason": "_depositAmount is the amount converted in the conversion entrypoint.",
      "merge_into": "fn_convertEthToMet",
      "normal_node": "p_depositAmount"
    },
    {
      "reason": "_minReturn is the slippage guard checked during redeem.",
      "merge_into": "fn_redeem",
      "normal_node": "p_minReturn"
    },
    {
      "reason": "_wei is the payment value processed by the payable fallback.",
      "merge_into": "fn_fallbackAuctions",
      "normal_node": "p_wei"
    },
    {
      "reason": "_timestamp determines the tick used in purchase pricing.",
      "merge_into": "fn_calcPurchase",
      "normal_node": "p_timestamp"
    },
    {
      "reason": "_importData holds the metadata consumed by importMET.",
      "merge_into": "fn_importMET",
      "normal_node": "p_importData"
    },
    {
      "reason": "_destChain selects the destination chain during export.",
      "merge_into": "fn_export",
      "normal_node": "p_destChain"
    },
    {
      "reason": "_owners array feeds the batch subWithdrawFor iteration.",
