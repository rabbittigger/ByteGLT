  "normalization_plan": [
    {
      "normal_node": "param_amount_transfer",
      "reason": "the amount parameter only exists to drive the internal _transfer logic and carries no standalone semantics",
      "merge_into": "func_transfer_internal"
    },
    {
      "normal_node": "param_recipient_transfer",
      "reason": "the recipient parameter is a plain forwarding argument of the external transfer function",
      "merge_into": "func_transfer"
    },
    {
      "normal_node": "param_sender_transferFrom",
      "reason": "the sender parameter is a plain forwarding argument consumed only by transferFrom",
      "merge_into": "func_transferFrom"
    },
    {
      "normal_node": "local_contractTokenBalance",
      "reason": "the local contract token balance is computed solely to be spent by swapTokensForEth",
      "merge_into": "func_swapTokensForEth"
    },
    {
      "normal_node": "local_contractETHBalance",
      "reason": "the local ETH balance is read solely to be forwarded by sendETHToFee",
      "merge_into": "func_sendETHToFee"
    },
    {
      "normal_node": "param_tokenAmount_swap",
      "reason": "tokenAmount is the input amount of the external router swap operation",
      "merge_into": "unsafe_routerSwap"
    },
    {
      "normal_node": "param_amount_sendETH",
      "reason": "amount is the value forwarded by the external ETH transfers to fee wallets",
      "merge_into": "unsafe_feeTransfer"
    },
    {
      "normal_node": "local_currentRate",
      "reason": "currentRate is just the return value of _getRate and holds no independent behavior",
      "merge_into": "func_getRate"
    }
  ]
}