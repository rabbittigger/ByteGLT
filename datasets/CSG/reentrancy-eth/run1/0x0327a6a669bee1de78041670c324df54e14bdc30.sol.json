      "normal_node": "param_amount",
      "reason": "amount flows directly into the fee subtraction and proportional fee arithmetic"
    },
    {
      "merge_into": "fn_updateSwapTokensAtAmount",
      "normal_node": "param_newAmount",
      "reason": "newAmount is the sole threshold parameter of updateSwapTokensAtAmount"
    },
    {
      "merge_into": "fn_updateMarketingWallet",
      "normal_node": "param_newMarketingWallet",
      "reason": "newMarketingWallet is written straight back to the marketingWallet state"
    },
    {
      "merge_into": "fn_buyBackTokens",
      "normal_node": "param_ethAmountInWei",
      "reason": "ethAmountInWei is the value passed to the external router buyback swap"
    },
    {
      "merge_into": "uo_amount_minus_fees",
      "normal_node": "lv_fees",
      "reason": "local fees is the computed fee that is subtracted from amount"
    },
    {
      "merge_into": "fn_swapBack",
      "normal_node": "lv_contractBalance",
      "reason": "contractBalance is a transient snapshot used only within swapBack"
    },
    {
      "merge_into": "fn_swapBack",
      "normal_node": "lv_totalTokensToSwap",
      "reason": "totalTokensToSwap is a transient denominator local to swapBack"
    },
    {
      "merge_into": "fn_swapBack",
      "normal_node": "lv_ethBalance",
      "reason": "ethBalance is a transient ETH delta local to swapBack"
    }
  ]
}