      "normal_node": "local.ct.rejectTransfer.from",
      "reason": "from address selects which pending amount is released in rejectTransfer"
    },
    {
      "merge_into": "fn.complianttoken.transfer",
      "normal_node": "param.ct.transfer._to",
      "reason": "recipient recorded in the queued TransactionStruct"
    },
    {
      "merge_into": "fn.complianttoken.transfer",
      "normal_node": "param.ct.transfer._value",
      "reason": "value used for balance reservation in CompliantToken.transfer"
    },
    {
      "merge_into": "fn.mintable.mint",
      "normal_node": "param.mintable.mint._to",
      "reason": "mint recipient used for the balance update"
    },
    {
      "merge_into": "uo.mintable.mint.additions",
      "normal_node": "param.mintable.mint._amount",
      "reason": "minted amount is added to totalSupply_ and balances"
    },
    {
      "merge_into": "fn.ownable.transferOwnership",
      "normal_node": "param.ownable.transferOwnership.newOwner",
      "reason": "newOwner is assigned to the owner state variable"
    },
    {
      "merge_into": "fn.validator.setNewValidator",
      "normal_node": "param.validator.setNewValidator.newValidator",
      "reason": "newValidator is assigned to the validator state variable"
    },
    {
      "merge_into": "fn.whitelist.approveInvestor",
      "normal_node": "param.whitelist.approveInvestor.toApprove",
      "reason": "investor address written into investorMap"
    },
    {
      "merge_into": "fn.ccs.setWhitelistContract",
      "normal_node": "param.ccs.setWhitelistContract.whitelistAddress",
      "reason": "whitelist address cast and stored in whiteListingContract"
    }
  ]
}