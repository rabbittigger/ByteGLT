  "normalization_plan": [
    {
      "reason": "spender is only used as the approve allowance key, so it folds into the approve function node",
      "normal_node": "erc20.approve.spender",
      "merge_into": "erc20.approve"
    },
    {
      "reason": "amount is only used as the approved allowance value inside approve",
      "normal_node": "erc20.approve.amount",
      "merge_into": "erc20.approve"
    },
    {
      "reason": "recipient is used only to forward the transfer destination in transfer",
      "normal_node": "erc20.transfer.recipient",
      "merge_into": "erc20.transfer"
    },
    {
      "reason": "amount is used only to forward the transferred value in transfer",
      "normal_node": "erc20.transfer.amount",
      "merge_into": "erc20.transfer"
    },
    {
      "reason": "sender is used only as the debited account in transferFrom",
