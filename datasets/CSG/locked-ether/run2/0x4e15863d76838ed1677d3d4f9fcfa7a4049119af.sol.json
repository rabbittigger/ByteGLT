      "normal_node": "param_value",
      "merge_into": "excludeFromFees"
    },
    {
      "reason": "newFee is directly assigned to the txFees state variable by setFee",
      "normal_node": "param_newFee",
      "merge_into": "setFee"
    },
    {
      "reason": "newLimit is scaled and written into maxTxLimit by setMaxTxLimit",
      "normal_node": "param_newLimit",
      "merge_into": "setMaxTxLimit"
    },
    {
      "reason": "amountToSwap is scaled and written into swapAtAmount by setSwapAtAmount",
      "normal_node": "param_amountToSwap",
      "merge_into": "setSwapAtAmount"
    },
    {
      "reason": "newWallet is directly assigned to the dev state variable by updateDevWallet",
      "normal_node": "param_newWallet",
      "merge_into": "updateDevWallet"
    },
    {
      "reason": "from is the source address used throughout the checks and state mutations of _transfer",
      "normal_node": "param_from",
      "merge_into": "_transfer"
    },
    {
      "reason": "to is the destination address used in balance and limit checks of _transfer",
      "normal_node": "param_to",
      "merge_into": "_transfer"
    },
    {
      "reason": "amount is the quantity checked against limits and reduced by fees in _transfer",
      "normal_node": "param_amount",
      "merge_into": "_transfer"
    },
    {
      "reason": "tokenAmount is the input amount supplied to the external router swap call",
      "normal_node": "param_tokenAmount",
      "merge_into": "_swapTokensForETH"
    },
    {
      "reason": "contractTokenBalance is a temporary read of the contract balance used only inside _transfer",
      "normal_node": "local_contractTokenBalance",
      "merge_into": "_transfer"
    },
    {
      "reason": "canSwap is a temporary boolean derived from swapAtAmount used only inside _transfer",
      "normal_node": "local_canSwap",
      "merge_into": "_transfer"
    },
    {
      "reason": "takeFee is a temporary boolean controlling fee logic inside _transfer",
      "normal_node": "local_takeFee",
      "merge_into": "_transfer"
    },
    {
      "reason": "fees is the temporary arithmetic result consumed by the fee application operation",
      "normal_node": "local_fees",
      "merge_into": "feeApplication"
    }
